# Frontend environment variables
# Copy to .env and adjust values.

# API base URL for HTTP calls (defaults to empty — uses Vite proxy)
VITE_API_BASE_URL=

# WebSocket base URL. Empty derives from window.location (same-origin).
# In dev, point this directly at the backend to bypass Vite's ws proxy,
# which mishandles WebSocket disconnects (logs EPIPE/ECONNRESET).
VITE_WS_BASE_URL=ws://localhost:8000

# Seconds per question before auto-submit (default 10).
VITE_ANSWER_TIME_LIMIT_SEC=10
