APP_NAME="AI Tutor Screener"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# CORS: comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Session
SESSION_INACTIVITY_TIMEOUT_SECONDS=120
MAX_SILENCE_SECONDS=10
SILENCE_PROMPT_SECONDS=5
SHORT_ANSWER_MAX_WORDS=3
MAX_FOLLOWUPS_PER_STAGE=1
MAX_TOTAL_QUESTIONS=18

# AI provider. Provider is one of: gemini, openai, ollama, nvidia, mock
#   mock   — offline canned responses (no API key needed)
#   gemini — FASTEST + free tier. Get a free API key (starts with "AIza...")
#            from Google AI Studio: https://aistudio.google.com/app/apikey
#   nvidia — NVIDIA free endpoint; list one or more models below, the backend
#            health-checks each and routes to the first healthy one
#   openai — any OpenAI-compatible endpoint
#   ollama — local Ollama server (set BASE_URL=http://localhost:11434/v1)
AI_PROVIDER="gemini"
# Fast free Gemini models (list in preference order — router tries the first
# that works):
#   gemini-2.5-flash     — great balance of speed + quality (free tier)
#   gemini-2.0-flash     — very fast, great for screening (free tier)
#   gemini-2.5-flash-lite — fastest, most economical (free tier)
AI_GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash"
AI_GEMINI_MODEL="gemini-2.5-flash"
# Put your real key in .env (never commit it). MUST start with "AIza..."
# (an OAuth token like "AQ..." or "ya29..." will return 401).
AI_GEMINI_API_KEY="AIza-YOUR_GEMINI_API_KEY_HERE"
AI_GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# NVIDIA (optional fallback / alternative). gpt-oss-20b is free; gpt-oss-120b
# is free but noticeably slower.
# AI_PROVIDER="nvidia"
# AI_MODELS="openai/gpt-oss-20b"
# AI_MODEL="openai/gpt-oss-20b"
# AI_API_KEY="nvapi-YOUR_NVIDIA_API_KEY_HERE"
# AI_BASE_URL="https://integrate.api.nvidia.com/v1"
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_MAX_TOKENS=1024

# STT
STT_PROVIDER="local"
STT_MODEL="tiny"
STT_LANGUAGE="en"
STT_DEVICE="cpu"
STT_COMPUTE_TYPE="int8"
STT_MIN_AUDIO_BYTES=2000

# TTS
TTS_PROVIDER="edge"
TTS_VOICE="en-US-AriaNeural"
TTS_RATE="+4%"
